# DeepGuard AI — cross-platform local environment template
# Copy this file to backend/.env and replace the placeholders.
# Never commit backend/.env or real secrets.

DATABASE_URL=mysql+pymysql://deepguard_app:YOUR_URL_ENCODED_PASSWORD@localhost:3306/deepguard
SECRET_KEY=replace-with-a-long-random-secret
# Streamlit secure local UI uses https://localhost:8501.
# Keep http://localhost:8501 too if you also use ordinary local HTTP development.
CORS_ORIGINS=https://localhost:8501,http://localhost:8501,http://localhost:5173,http://localhost:3000,http://127.0.0.1:8501,http://127.0.0.1:5173
DEVICE=cpu
DEFAULT_MODEL=efficientnet
# FastAPI is a local server-to-server dependency for Streamlit.
DEEPGUARD_API_URL=http://localhost:8000
