# DeepGuard AI — cross-platform local environment template
# Copy this file to backend/.env and replace the placeholders.
# Never commit backend/.env or real secrets.

DATABASE_URL=mysql+pymysql://deepguard_app:YOUR_URL_ENCODED_PASSWORD@localhost:3306/deepguard
SECRET_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:8501
DEVICE=cpu
DEFAULT_MODEL=efficientnet
DEEPGUARD_API_URL=http://localhost:8000
